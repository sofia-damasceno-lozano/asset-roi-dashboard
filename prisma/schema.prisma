generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  assets    Asset[]
}

model Asset {
  id             String   @id @default(uuid())
  name           String
  type           String
  purchaseValue  Float
  currentValue   Float

  userId String
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
